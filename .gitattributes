# Normalize line endings for text files.
* text=auto

# C# and docs
*.cs     text diff=csharp
*.md     text
*.json   text
*.asmdef text

# Unity YAML assets: always LF, merged with Unity's Smart Merge tool if configured.
*.unity  text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset  text eol=lf merge=unityyamlmerge
*.mat    text eol=lf merge=unityyamlmerge
*.anim   text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
